{
  "auto-format-typst": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "typstyle -i -l 300 ../*.typ 2>/dev/null; echo '{}'"
          }
        ]
      }
    ]
  }
}
